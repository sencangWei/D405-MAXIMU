#!/usr/bin/env bash
# Restored-original v1 pipeline: original-era MASt3R-SLAM frontend
# (CURRENT toolchain @ 26c0273c + era default config: IMU rotation prior on,
# no motion-keyframes, default retrieval confirmation — this combination is
# proven: regression_13 baseline (code@88712be9, same config) reached stereo
# dispersion 0.151 on d405_20260908_222718; the reconstructed d06f5a8c tree
# reaches only 0.686 with the same config, so the current tree is the most
# original-faithful recoverable frontend) + UMI stereo/IMU scale gates +
# original keyframe-graph fusion + ORIGINAL complementary fusion parameters
# (smoothing 7.25 s, local weight 0.225, scale weight 0.475, adaptive local
# weight on), as recorded in the 2026-09-12 fusion reports. The 9/13-16
# degenerative changes (zeroed fusion weights, 8 s smoothing) are excluded.
#
# 用法: mast3r_fusion_original_v1_workflow.sh <D405会话目录> <Docker2/VINS轨迹.csv> <输出目录>
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
TOOL_DIR="/home/robot/ego_pipeline/work/toolchains/MASt3R-SLAM"
PYTHON="$TOOL_DIR/.venv/bin/python"
VINS_CONFIG="/home/robot/umi_docker2_product_1.0.0-20260829/docker2_release/formal_runtime_calibration/vins_config.yaml"
IMU_CALIBRATION="$ROOT_DIR/config/imu_runtime_accel_calibrated_raw_gyro_20260816.yaml"
CONFIG="$ROOT_DIR/config/mast3r_slam_d405_offline.yaml"

[[ $# -eq 3 ]] || { echo "用法: $0 <D405会话目录> <Docker2/VINS轨迹.csv> <输出目录>" >&2; exit 2; }
SESSION="$(realpath "$1")"
VINS_TRAJECTORY="$(realpath "$2")"
OUTPUT="$(realpath -m "$3")"

[[ -f "$SESSION/d405_frames.csv" ]] || { echo "D405会话无效: $SESSION" >&2; exit 2; }
[[ -f "$VINS_TRAJECTORY" ]] || { echo "Docker2/VINS轨迹不存在: $VINS_TRAJECTORY" >&2; exit 2; }

mkdir -p "$OUTPUT"
FRONTEND="$OUTPUT/frontend"
mkdir -p "$FRONTEND"

echo "[1/6] MASt3R原始前端（现行树 + 时代默认配置 = 可恢复的最忠实原始前端）"
MAST3R_SLAM_DIR="$TOOL_DIR" \
MAST3R_SLAM_CONFIG="$CONFIG" \
    "$ROOT_DIR/scripts/mast3r_slam_precision_workflow.sh" run \
    "$SESSION" "$FRONTEND" infrared_left 0 0

echo "[2/6] D405双红外短窗尺度"
"$PYTHON" "$ROOT_DIR/scripts/align_mast3r_scale_with_stereo.py" \
    --session "$SESSION" \
    --trajectory "$FRONTEND/trajectory_frames.csv" \
    --trajectory-frame infrared_left \
    --motion-estimator pnp \
    --frame-step 5 \
    --max-hop 5 \
    --max-depth-m 0.6 \
    --output "$OUTPUT/trajectory_stereo_bidirectional.csv" \
    --report "$OUTPUT/stereo_scale_bidirectional_report.json"

echo "[3/6] D405双红外8/12/16帧跨窗尺度"
"$PYTHON" "$ROOT_DIR/scripts/align_mast3r_scale_with_stereo.py" \
    --session "$SESSION" \
    --trajectory "$FRONTEND/trajectory_frames.csv" \
    --trajectory-frame infrared_left \
    --motion-estimator pnp \
    --frame-step 5 \
    --hop-values 8,12,16 \
    --max-depth-m 0.6 \
    --output "$OUTPUT/trajectory_stereo_long_hops.csv" \
    --report "$OUTPUT/stereo_scale_long_hops_report.json"

echo "[4/6] 400 Hz IMU米制尺度和偏置"
"$PYTHON" "$ROOT_DIR/scripts/align_mast3r_scale_with_imu.py" \
    --session "$SESSION" \
    --trajectory "$FRONTEND/trajectory_frames.csv" \
    --stream infrared_left \
    --body-t-camera-yaml "$VINS_CONFIG" \
    --imu-calibration "$IMU_CALIBRATION" \
    --td-s -0.009109323 \
    --node-stride 10 \
    --max-hop 1 \
    --output "$OUTPUT/trajectory_imu_metric.csv" \
    --report "$OUTPUT/imu_scale_report.json"

echo "[5/6] 原始关键帧图优化（legacy_v10 语义）"
"$PYTHON" "$ROOT_DIR/scripts/fuse_mast3r_stereo_imu_legacy_v10.py" \
    --session "$SESSION" \
    --trajectory "$OUTPUT/trajectory_imu_metric.csv" \
    --stream infrared_left \
    --stereo-report "$OUTPUT/stereo_scale_bidirectional_report.json" \
    --additional-stereo-report "$OUTPUT/stereo_scale_long_hops_report.json" \
    --imu-scale-report "$OUTPUT/imu_scale_report.json" \
    --vins-config "$VINS_CONFIG" \
    --imu-calibration "$IMU_CALIBRATION" \
    --expected-td-s -0.009109323 \
    --orientation-node-stride 10 \
    --position-node-stride 10 \
    --minimum-stereo-sample-hop 1 \
    --keyframe-dir "$FRONTEND/mast3r_logs/keyframes/dataset" \
    --relative-motion-trajectory "$VINS_TRAJECTORY" \
    --relative-motion-sigma-m 0.012 \
    --full-rate-imu-position-refinement \
    --full-rate-max-correction-mm 20 \
    --metric-scale-mode stereo \
    --position-mode keyframe-graph \
    --output "$OUTPUT/trajectory_graph.csv" \
    --report "$OUTPUT/graph_report.json"

echo "[6/6] 原始互补融合（7.25 s / 0.225 / 0.475 / 自适应）"
"$PYTHON" "$ROOT_DIR/scripts/fuse_docker2_mast3r_complementary_legacy_v10.py" \
    --mast3r "$OUTPUT/trajectory_graph.csv" \
    --docker2 "$VINS_TRAJECTORY" \
    --body-t-camera-yaml "$VINS_CONFIG" \
    --scale-horizon-s 1 \
    --smoothing-s 7.25 \
    --docker2-local-weight 0.225 \
    --docker2-scale-weight 0.475 \
    --adaptive-local-weight \
    --roughness-threshold-mm 9 \
    --adaptive-weight-strength 0.45 \
    --use-docker2-orientation-for-lever-arm \
    --output "$OUTPUT/trajectory_fused.csv" \
    --report "$OUTPUT/fusion_report.json"

python3 - "$OUTPUT" <<'PY'
import json
import shutil
import sys
from pathlib import Path

root = Path(sys.argv[1])
graph = json.loads((root / "graph_report.json").read_text(encoding="utf-8"))
fusion = json.loads((root / "fusion_report.json").read_text(encoding="utf-8"))
if graph.get("result") != "PASS" or graph.get("slam_supervision"):
    raise SystemExit("图优化未通过内部质量门禁")
if graph.get("inputs", {}).get("external_ground_truth_used") is not False:
    raise SystemExit("没有证明外部真值未参与")
if fusion.get("result") != "PASS" or fusion.get("external_ground_truth_used") is not False:
    raise SystemExit("互补融合未通过无监督门禁")
print("original_v1 门禁通过: " + str(root / "trajectory_fused.csv"))
PY

echo "原始v1融合轨迹: $OUTPUT/trajectory_fused.csv"
echo "算法输入仅包含D405双红外、UMI 400 Hz IMU、MASt3R和Docker2/VINS轨迹。"
