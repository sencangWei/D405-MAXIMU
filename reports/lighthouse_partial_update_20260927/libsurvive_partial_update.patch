diff --git a/src/optical_partial_support.h b/src/optical_partial_support.h
new file mode 100644
--- /dev/null
+++ b/src/optical_partial_support.h
@@ -0,0 +1,12 @@
+#ifndef SURVIVE_OPTICAL_PARTIAL_SUPPORT_H
+#define SURVIVE_OPTICAL_PARTIAL_SUPPORT_H
+#include <math.h>
+
+/* An opt-in fallback, never an initialization or single-station solve. */
+static inline int survive_optical_partial_supported(int required_stations, int full_stations,
+	int supported_stations, int strong_axes, int initialized, double covariance_scale) {
+	return isfinite(covariance_scale) && covariance_scale >= 1. && required_stations == 2 && full_stations < 2 &&
+		initialized && supported_stations >= 2 && strong_axes >= 3;
+}
+
+#endif
