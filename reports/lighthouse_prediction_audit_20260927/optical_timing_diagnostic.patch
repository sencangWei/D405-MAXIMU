diff --git a/src/survive_kalman_tracker.c b/src/survive_kalman_tracker.c
index 484cf8c..a7731f5 100644
--- a/src/survive_kalman_tracker.c
+++ b/src/survive_kalman_tracker.c
@@ -1185,6 +1185,15 @@ void survive_kalman_tracker_integrate_observation(PoserData *pd, SurviveKalmanTr
