+static bool map_obs_data(void *user, const struct CnMat *Z, const struct CnMat *x_t, struct CnMat *y,
+								   struct CnMat *H_k) {
+	SurviveKalmanTracker *tracker = user;
+	if (tracker->observation_lag <= 0) {
+		return map_obs_data_current(user, Z, x_t, y, H_k);
+	}
+	/* Evaluate a delayed measurement at its device time, not at the clamped
+	 * filter time. This deterministic short-delay model is experimental; it
+	 * is not a rewind/replay of the filter's intervening measurements. */
+	CN_CREATE_STACK_VEC(past, x_t->rows);
+	CN_CREATE_STACK_MAT(F, tracker->model.error_state_size, tracker->model.error_state_size);
+	survive_kalman_error_tracker_predict_jac(-tracker->observation_lag, &tracker->model,
+										   x_t, &past, H_k ? &F : 0);
+	CN_CREATE_STACK_MAT(H_past, Z->rows, tracker->model.error_state_size);
+	bool result = map_obs_data_current(user, Z, &past, y, H_k ? &H_past : 0);
+	if (H_k) {
+		cnGEMM(&H_past, &F, 1, 0, 0, H_k, 0);
+	}
+	CN_FREE_STACK_MAT(H_past);
+	CN_FREE_STACK_MAT(F);
+	CN_FREE_STACK_MAT(past);
+	return result;
+}
