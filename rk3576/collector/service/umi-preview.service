[Unit]
Description=UMI RK3576 EGO-compatible RGB preview
After=network.target

[Service]
Type=simple
EnvironmentFile=%h/.config/umi-recorder/umi-recorder.env
ExecStart=%h/umi-collector/current/bin/umi-preview-service
Restart=on-failure
RestartSec=1
KillSignal=SIGINT
TimeoutStopSec=12

[Install]
WantedBy=default.target
