UMI_DEVICE_ID=CHANGE_ME_UMI_RK3576_UNIT
UMI_RECORDING_ROOT=/home/pi/umi-recordings
UMI_STATE_DIR=/home/pi/.local/state/umi-recorder
UMI_D405_SDK_SERIAL=CHANGE_ME_D405_SDK_SERIAL
UMI_D405_USB_SERIAL=CHANGE_ME_D405_USB_DESCRIPTOR_SERIAL
UMI_STM32_PORT=/dev/serial/by-id/CHANGE_ME_STM32_BY_ID
UMI_PREVIEW_SOURCE_PORT=18081
UMI_ADMIN_PUBLIC_KEY_DIR=/home/pi/.config/umi-recorder/admin-public-keys
UMI_ADMIN_TLS_CERT=/home/pi/.config/umi-recorder/tls/admin.crt
