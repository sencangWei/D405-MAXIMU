[Unit]
Description=UMI RK3576 signed catalog and resumable transfer API
After=network.target umi-preview.service

[Service]
Type=simple
EnvironmentFile=%h/.config/umi-recorder/umi-recorder.env
ExecStart=%h/umi-collector/current/bin/umi-admin-service
Restart=on-failure
RestartSec=1
KillSignal=SIGINT
TimeoutStopSec=12

[Install]
WantedBy=default.target
