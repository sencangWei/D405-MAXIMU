[Unit]
Description=UMI RK3576 local Web control console
After=network.target umi-preview.service umi-admin.service
Wants=umi-preview.service umi-admin.service

[Service]
Type=simple
WorkingDirectory=%h/umi-collector/current/web-console
ExecStart=/usr/bin/python3 -B %h/umi-collector/current/web-console/device_server.py --bind 0.0.0.0 --port 8766
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=3
KillMode=process
TimeoutStopSec=10
UMask=0077

[Install]
WantedBy=default.target
