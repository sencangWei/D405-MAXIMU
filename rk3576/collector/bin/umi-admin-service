#!/usr/bin/env bash
set -euo pipefail
UMI_RELEASE_ROOT=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
: "${UMI_DEVICE_ID:?UMI_DEVICE_ID is required}"
: "${UMI_RECORDING_ROOT:?UMI_RECORDING_ROOT is required}"
: "${UMI_STATE_DIR:?UMI_STATE_DIR is required}"
: "${UMI_ADMIN_PUBLIC_KEY_DIR:?UMI_ADMIN_PUBLIC_KEY_DIR is required}"
: "${UMI_ADMIN_TLS_CERT:?UMI_ADMIN_TLS_CERT is required}"
: "${UMI_ADMIN_TLS_KEY:?UMI_ADMIN_TLS_KEY is required}"
mkdir -p -- "$UMI_STATE_DIR" "$UMI_ADMIN_PUBLIC_KEY_DIR"
chmod 700 -- "$UMI_STATE_DIR" "$UMI_ADMIN_PUBLIC_KEY_DIR"
touch -- "$UMI_STATE_DIR/transfer-operation.lock"
chmod 600 -- "$UMI_STATE_DIR/transfer-operation.lock"
export PYTHONPATH="$UMI_RELEASE_ROOT/adapter:$UMI_RELEASE_ROOT/vendor/ego-runtime:$UMI_RELEASE_ROOT/vendor/site-packages${PYTHONPATH:+:$PYTHONPATH}"
export EGO_PLATFORM=umi_rk3576
export STATE_DIRECTORY="$UMI_STATE_DIR"
export EGO_DEVICE_ID="$UMI_DEVICE_ID"
export EGO_RECORDING_ROOT="$UMI_RECORDING_ROOT"
export EGO_RECORDERCTL_PATH="$UMI_RELEASE_ROOT/adapter/umi_recorderctl.py"
export EGO_PYTHON=/usr/bin/python3
export EGO_CATALOG_DB="$UMI_STATE_DIR/catalog.sqlite3"
export EGO_MAINTENANCE_LOCK="$UMI_STATE_DIR/transfer-operation.lock"
export EGO_ADMIN_PUBLIC_KEY_DIR="$UMI_ADMIN_PUBLIC_KEY_DIR"
export EGO_ADMIN_APP_FACTORY=ego_service_runtime:create_admin_app
export EGO_PREVIEW_HOST=127.0.0.1
export EGO_PREVIEW_PORT=18080
export EGO_RECEIPT_TTL_NS=3600000000000
exec /usr/bin/python3 -m uvicorn ego_service_bootstrap:create_admin_app --factory \
  --host 127.0.0.1 --port 18443 \
  --ssl-certfile "$UMI_ADMIN_TLS_CERT" --ssl-keyfile "$UMI_ADMIN_TLS_KEY"
